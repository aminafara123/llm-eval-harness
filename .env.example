# Copy to .env and adjust. Defaults target a local ollama; no API key is required.
# These are only needed to actually CALL a model (`run`). Tests and `diff` run offline.

# OpenAI-compatible chat endpoint used for the model under test (and optional llm_judge).
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
LLM_API_KEY=ollama
